# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
#
# Rule: nothing secret may be prefixed NEXT_PUBLIC_. Anything with that prefix
# is inlined into the browser bundle and is publicly readable. v1 leaked its AI
# key exactly this way.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local (docker compose) or your Neon "recallify-dev" branch.
DATABASE_URL="postgresql://recallify:recallify@localhost:5432/recallify?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- AI -------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# --- App ------------------------------------------------------------------
NODE_ENV="development"
API_PORT="3001"
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# --- Observability (phase 7) ----------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="debug"
