# Firebase Web API key (public by design - security comes from database rules)
VITE_FIREBASE_API_KEY=

# Realtime Database URL, e.g. https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_DB_URL=

# WARNING: any VITE_ variable is inlined into the client bundle and is publicly
# readable on the deployed site. Do not put a real secret here. In v2 all AI
# calls are made server-side for exactly this reason.
VITE_OPENROUTER_API_KEY=
