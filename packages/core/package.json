{
  "name": "@recallify/core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@recallify/contracts": "workspace:*",
    "@recallify/fsrs": "workspace:*",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@types/react": "^19.0.0",
    "react": "^19.2.0",
    "vitest": "^2.1.3"
  },
  "files": [
    "dist"
  ]
}
