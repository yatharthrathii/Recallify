{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // CommonJS because NestJS with SWC transpiles file by file and does not
    // bundle -- it leaves real require() calls, so a package pointing at raw
    // .ts source cannot be loaded at runtime. Next.js and Vitest both consume
    // CommonJS without complaint, so one output format serves every consumer.
    "module": "CommonJS",
    "moduleResolution": "Node",

    // Turbo is the build cache here. tsc's own incremental cache is a second
    // one that can disagree with it: .tsbuildinfo sits beside the config
    // rather than inside dist/, so deleting dist/ leaves tsc believing it is
    // up to date. It emits nothing, turbo caches that nothing as the build
    // output, and the next cache hit restores an empty dist/ -- at which
    // point every package that imports it stops resolving. One cache, not two.
    "incremental": false,

    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*", "**/*.test.ts"]
}
