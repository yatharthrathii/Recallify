// Recallify v2 schema. See docs/03-DATA-AND-API.md for the reasoning.
//
// Two invariants govern this file:
//   1. Review is append-only. It is the event log the forgetting curve, the
//      optimizer and the backtest are all derived from. Never update, never
//      delete. Card FSRS state is a cache of replaying it.
//   2. Every user-owned row carries userId so the due-queue query can filter on
//      it directly. Ownership is enforced in the WHERE clause, never after.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Neon serves two endpoints. The pooled one (host contains "-pooler") runs
  // PgBouncer in transaction mode, which cannot hold the advisory locks and
  // prepared statements `prisma migrate` needs -- migrations against it fail
  // with errors that do not say why. The app uses the pooled URL; migrations
  // use the direct one.
  //
  // With a local Docker Postgres there is no pooler, so both point at the same
  // place and this costs nothing.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // FSRS personalisation. Empty fsrsParams means "use published defaults".
  fsrsParams        Float[]
  desiredRetention  Float     @default(0.90)
  dailyNewLimit     Int       @default(20)
  dailyReviewLimit  Int       @default(200)
  paramsOptimizedAt DateTime?

  isDemo Boolean @default(false)

  // AI cards this user may generate per UTC day. Stored rather than hardcoded:
  // generation is the one feature with a real marginal cost, so it is the one
  // a paid tier would change -- and that should be an UPDATE, not a deploy.
  aiDailyLimit Int @default(20)

  decks         Deck[]
  cards         Card[]
  reviews       Review[]
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  stats         UserStats?
  aiUsage       AiUsage[]
  aiReports     AiReport[]

  @@map("users")
}

// Rotating refresh tokens with reuse detection. If a revoked token is presented
// again, every token sharing its familyId is revoked: a stolen token cannot
// outlive the legitimate session.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256. The raw token is never stored.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// One-shot password reset links. The raw token goes in the email and only
// its SHA-256 is kept, so a database read cannot be turned into a sign-in.
// Using a link marks it used and revokes every refresh token the user has.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}

model Deck {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  color       String    @default("amber")
  isPublic    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([userId, archivedAt])
  @@map("decks")
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum CardSource {
  MANUAL
  AI
  IMPORT
}

model Card {
  id     String     @id @default(cuid())
  deckId String
  userId String // denormalised: every due-queue query filters on it
  front  String
  back   String
  hint   String?
  source CardSource @default(MANUAL)

  // FSRS state. Derived from the Review log, cached here so the due query is
  // a single indexed read instead of a replay.
  state          CardState @default(NEW)
  stability      Float     @default(0)
  difficulty     Float     @default(0)
  dueAt          DateTime  @default(now())
  reps           Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime?
  suspendedAt    DateTime?

  // Which rung of the learning ladder the card is on, while it is in LEARNING
  // or RELEARNING. Without it a learning card is ambiguous: "answered Again,
  // back to 1 minute" and "answered Good once, now at 10 minutes" would look
  // identical. Meaningless in NEW and REVIEW, where it stays 0.
  learningStep   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deck    Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@index([userId, dueAt]) // THE due-queue query
  @@index([deckId, dueAt])
  @@index([userId, state])
  @@map("cards")
}

// Append-only. The id is generated on the client, which makes it the
// idempotency key: a retried offline sync cannot double-count a review.
model Review {
  id     String @id
  cardId String
  userId String
  rating Int // 1 Again - 2 Hard - 3 Good - 4 Easy

  // State BEFORE this review, so the log is replayable on its own.
  prevState      CardState
  prevStability  Float
  prevDifficulty Float

  newStability   Float
  newDifficulty  Float
  scheduledDays  Int
  elapsedDays    Int
  retrievability Float // predicted R at the moment of review
  durationMs     Int?

  reviewedAt DateTime // client clock: when it actually happened
  syncedAt   DateTime @default(now()) // server clock: when it arrived

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([cardId, reviewedAt])
  @@map("reviews")
}

// xp is cumulative and level is derived from it. v1 did `xp = xp % 100`, which
// silently destroyed the running total every time a user crossed 100.
model UserStats {
  userId        String    @id
  xp            Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// One row per generation. Written BEFORE the model is called, as a
// reservation, and corrected or deleted afterwards -- see AiService.generate
// for why the order matters under concurrency.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  promptTokens Int
  outputTokens Int
  cardsCreated Int // cards charged against the daily allowance
  model        String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // rate-limit window query
  @@map("ai_usage")
}

// A user flagging AI output. Play requires the in-app path; "incorrect" exists
// because a wrong card is the failure that was actually observed.
//
// A snapshot of the text, not a card id: drafts that were never saved have no
// id, and a report has to outlive the card it is about.
model AiReport {
  id        String   @id @default(cuid())
  userId    String
  front     String
  back      String
  reason    String // offensive | incorrect | other
  note      String?
  model     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("ai_reports")
}

// Counted events for rate limits: failed sign-ins, demo accounts made. Kept in
// the database rather than in memory because the API runs on serverless
// instances that share nothing, so a per-process counter would hand every
// instance its own fresh allowance. Rows older than a day are swept on write.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
  @@map("rate_limit_hits")
}
